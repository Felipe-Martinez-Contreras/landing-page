---
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import type { ExperienceView } from "../../lib/experience";

interface Props {
  title: string;
  bio: string[];
  timelineLabel: string;
  timeline: ExperienceView[];
  languagesTitle: string;
  languages: { name: string; level: string }[];
}

const { title, bio, timelineLabel, timeline, languagesTitle, languages } =
  Astro.props;
---

<Section id="sobre-mi" title={title}>
  <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
    <div class="max-w-measure space-y-4 lg:col-span-7">
      {bio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <!-- A real sequence, so a timeline is justified (CLAUDE.md §6). -->
    <ol
      aria-label={timelineLabel}
      class="max-w-measure border-l border-line lg:col-span-7"
    >
      {timeline.map((entry) => (
        <li class="grid gap-y-1 pb-10 pl-5 last:pb-0 sm:grid-cols-4 sm:gap-x-6 sm:pl-6">
          <p class="text-sm text-ink-muted tabular-nums">
            {entry.start && (
              <>
                <time datetime={entry.start.datetime}>{entry.start.label}</time>
                {"–"}
              </>
            )}
            {entry.end.datetime ? (
              <time datetime={entry.end.datetime}>{entry.end.label}</time>
            ) : (
              <span>{entry.end.label}</span>
            )}
            {entry.dateNote && <span class="block">{entry.dateNote}</span>}
          </p>
          <div class="sm:col-span-3">
            <Heading level={3}>{entry.title}</Heading>
            <p class="mt-1 text-ink-muted">{entry.organization}</p>
            {entry.description && <p class="mt-3">{entry.description}</p>}
            {entry.highlights.length > 0 && (
              <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-ink-muted">
                {entry.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <!-- Last in reading order; on desktop it sits in the annotation margin. -->
    <div class="lg:col-span-4 lg:col-start-9 lg:row-start-1">
      <Heading level={3}>{languagesTitle}</Heading>
      <ul class="mt-3 space-y-1">
        {languages.map((language) => (
          <li>
            <span class="font-bold">{language.name}</span>
            {": "}
            <span class="text-ink-muted">{language.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
