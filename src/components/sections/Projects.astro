---
import Card from "../ui/Card.astro";
import CardLink from "../ui/CardLink.astro";
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import type { ProjectView } from "../../lib/projects";

interface Props {
  title: string;
  projects: ProjectView[];
  labels: {
    problem: string;
    approach: string;
    result: string;
    role: string;
    tech: string;
  };
}

const { title, projects, labels } = Astro.props;
---

<Section id="proyectos" title={title}>
  <!-- Featured projects are wide rows; the rest, compact rows close to a table (DESIGN.md §4). -->
  <ul class="border-b border-line">
    {projects.map((project) => (
      <Card as="li" class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-8">
        <div id={project.anchor} class="scroll-mt-18 lg:col-span-7">
          <Heading level={3}>
            {project.primary ? (
              <CardLink href={project.primary.href}>{project.title}</CardLink>
            ) : (
              project.title
            )}
          </Heading>

          {project.featured ? (
            <>
              <p class="mt-3 max-w-measure text-lead">{project.summary}</p>
              <p class="mt-3 max-w-measure">
                <strong>{labels.result}:</strong> {project.result}
              </p>
            </>
          ) : (
            <dl class="mt-3 max-w-measure space-y-2">
              {[
                [labels.problem, project.problem],
                [labels.approach, project.approach],
                [labels.result, project.result],
              ].map(([term, text]) => (
                <div>
                  <dt class="inline font-bold">{term}:</dt>{" "}
                  <dd class="inline">{text}</dd>
                </div>
              ))}
            </dl>
          )}

          {project.primary && (
            <p
              class="mt-4 font-bold text-accent underline-offset-4 group-hover:underline"
              aria-hidden="true"
            >
              {project.primary.label}
            </p>
          )}
        </div>

        <!-- Annotation margin: metadata of the figure. -->
        <div class="space-y-3 text-sm text-ink-muted lg:col-span-4 lg:col-start-9">
          <p class="flex flex-wrap gap-x-4">
            <span class="font-bold text-ink tabular-nums">{project.year}</span>
            <span>{project.status}</span>
          </p>
          {project.context && <p>{project.context}</p>}
          {project.role && (
            <p>
              {labels.role}: {project.role}
            </p>
          )}
          <ul aria-label={labels.tech} class="flex flex-wrap gap-2">
            {project.tech.map((item) => (
              <li>
                <Tag>{item.label}</Tag>
              </li>
            ))}
          </ul>
          {project.secondary.length > 0 && (
            <ul class="relative z-10 flex flex-wrap gap-x-4">
              {project.secondary.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-accent underline decoration-1 underline-offset-4 hover:decoration-2"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </Card>
    ))}
  </ul>
</Section>
