---
import Card from "../ui/Card.astro";
import Heading from "../ui/Heading.astro";
import Tag from "../ui/Tag.astro";
import type { LinkView } from "../../lib/projects";

interface Props {
  back: LinkView;
  title: string;
  summary: string;
  facts: {
    year: number;
    status: string;
    context?: string;
    role?: string;
    tech: string[];
    methods?: string[];
    links: LinkView[];
  };
  labels: {
    factsLabel: string;
    year: string;
    status: string;
    context: string;
    role: string;
    tech: string;
    methods: string;
    links: string;
  };
}

const { back, title, summary, facts, labels } = Astro.props;

// Text rows of the facts sheet; lists (tech, methods, links) go after them.
const rows = [
  [labels.year, String(facts.year)],
  [labels.status, facts.status],
  [labels.context, facts.context],
  [labels.role, facts.role],
].filter((row): row is [string, string] => row[1] !== undefined);
---

<!--
  Two children of the page grid: the title block (reading column) and the facts sheet
  (annotation margin), which spans the body's row on desktop (DESIGN.md §4).
-->
<header class="lg:col-span-7">
  <a
    href={back.href}
    class="inline-flex min-h-11 items-center text-accent underline decoration-1 underline-offset-4 hover:decoration-2"
  >
    {back.label}
  </a>
  <Heading level={1} class="mt-4">
    {title}
  </Heading>
  <p class="mt-5 max-w-measure text-lead">{summary}</p>
</header>

<aside
  aria-label={labels.factsLabel}
  class="lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:self-start"
>
  <Card as="div" variant="surface">
    <dl class="space-y-4 text-sm">
      {rows.map(([term, text]) => (
        <div>
          <dt class="font-bold">{term}</dt>
          <dd class="text-ink-muted">{text}</dd>
        </div>
      ))}
      <div>
        <dt class="font-bold">{labels.tech}</dt>
        <dd class="mt-1">
          <ul class="flex flex-wrap gap-2">
            {facts.tech.map((label) => (
              <li>
                <Tag>{label}</Tag>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      {facts.methods && facts.methods.length > 0 && (
        <div>
          <dt class="font-bold">{labels.methods}</dt>
          <dd class="text-ink-muted">
            <ul>
              {facts.methods.map((method) => (
                <li>{method}</li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      {facts.links.length > 0 && (
        <div>
          <dt class="font-bold">{labels.links}</dt>
          <dd>
            <ul class="flex flex-wrap gap-x-4">
              {facts.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-accent underline decoration-1 underline-offset-4 hover:decoration-2"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}
    </dl>
  </Card>
</aside>
