---
import Download from "@lucide/astro/icons/download";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import IconLink from "../ui/IconLink.astro";
import BrandIcon from "../ui/BrandIcon.astro";
import DotMap from "../ui/DotMap.astro";
import { getBrandIcon } from "../../lib/brands";
import type { ComponentProps } from "astro/types";

interface Props {
  name: string;
  role: string;
  valueProposition: string;
  availability: string;
  primary: { label: string; href: string };
  cv: { label: string; href: string };
  social: { id: string; label: string; href: string }[];
  socialLabel: string;
  /** The distinctive element (DESIGN.md §5). */
  figure?: Omit<ComponentProps<typeof DotMap>, "class" | "plotClass">;
}

const {
  name,
  role,
  valueProposition,
  availability,
  primary,
  cv,
  social,
  socialLabel,
  figure,
} = Astro.props;

// The name sets on two lines, as the title of the figure (DESIGN.md §3).
const nameLines = name.split(" ");
---

<section aria-labelledby="inicio-titulo" class="pt-10 pb-section sm:pt-16">
  <Container class="relative grid gap-y-10 lg:grid-cols-12 lg:gap-x-8">
    <!-- Below lg the map is a narrow strip beside the text; its caption follows the actions. -->
    <div class:list={["lg:col-span-7", figure && "pr-18 sm:pr-24 lg:pr-0"]}>
      <Heading level={1} size="display" id="inicio-titulo">
        {nameLines.map((line) => (
          <span class="block">{line}</span>
        ))}
        <span class="mt-5 block max-w-measure text-lead font-medium tracking-normal text-ink-muted font-stretch-normal">
          {role}
        </span>
      </Heading>

      <p class="mt-6 max-w-measure text-lead">{valueProposition}</p>
      <p class="mt-4 max-w-measure font-bold">{availability}</p>

      <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
        <Button href={primary.href} size="lg">
          {primary.label}
        </Button>
        <Button href={cv.href} variant="secondary" size="lg" download>
          <Download aria-hidden="true" />
          {cv.label}
        </Button>
        <ul aria-label={socialLabel} class="flex items-center gap-1">
          {social.map((link) => {
            const icon = getBrandIcon(link.id);
            return (
              <li>
                {icon ? (
                  <IconLink href={link.href} label={link.label}>
                    <BrandIcon icon={icon} />
                  </IconLink>
                ) : (
                  <IconLink href={link.href} label={link.label} showLabel />
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    {figure && (
      <DotMap
        {...figure}
        class="lg:col-span-4 lg:col-start-9"
        plotClass="absolute top-0 right-4 w-14 sm:right-6 sm:w-16 lg:static lg:w-24"
      />
    )}
  </Container>
</section>
