---
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import type { SkillGroupView } from "../../lib/skills";

interface Props {
  title: string;
  groups: SkillGroupView[];
  /** Evidence line, e.g. "Usado en 2 proyectos:". */
  usedIn: (count: number) => string;
}

const { title, groups, usedIn } = Astro.props;
---

<!-- Text first: no levels, bars or icons. Evidence comes from the projects (CLAUDE.md §6). -->
<Section id="habilidades" title={title}>
  <div class="grid gap-y-12 md:grid-cols-3 md:gap-x-8">
    {groups.map((group) => (
      <div>
        <Heading level={3}>{group.label}</Heading>
        <ul class="mt-4 border-t border-line">
          {group.skills.map((skill) => (
            <li class="border-b border-line py-2.5">
              <span class="font-bold">{skill.label}</span>
              {skill.note && (
                <>
                  {" "}
                  <span class="text-ink-muted">({skill.note})</span>
                </>
              )}
              {skill.projects.length > 0 && (
                <p class="text-sm text-ink-muted">
                  {usedIn(skill.projects.length)}{" "}
                  {skill.projects.map((project, index) => (
                    <>
                      {index > 0 && ", "}
                      <a
                        href={project.href}
                        class="text-accent underline decoration-1 underline-offset-4 hover:decoration-2"
                      >
                        {project.label}
                      </a>
                    </>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
