---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Long-form body (case studies). Colors come from the --tw-prose-* mapping in global.css. -->
<div
  class:list={[
    "prose max-w-measure",
    "prose-headings:font-heading prose-headings:text-ink",
    "prose-h2:text-h2 prose-h2:font-stretch-85% prose-h3:text-h3",
    // The plugin's em-based margins grow with the h2 token; keep them on the spacing scale.
    "prose-h2:mt-12 prose-h2:mb-4 prose-h3:mt-8 prose-h3:mb-3 [&>:first-child]:mt-0",
    "prose-a:underline-offset-4 hover:prose-a:decoration-2",
    "prose-pre:rounded-md prose-pre:border prose-pre:border-line prose-pre:font-mono",
    "prose-code:font-mono prose-code:before:content-none prose-code:after:content-none",
    "prose-figcaption:text-sm",
    className,
  ]}
>
  <slot />
</div>
