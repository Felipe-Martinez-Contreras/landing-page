---
type Level = 1 | 2 | 3;
type Size = "display" | "h1" | "h2" | "h3";

interface Props {
  level: Level;
  /** Visual size; defaults to the one matching the level. */
  size?: Size;
  id?: string;
  class?: string;
}

const { level, size, id, class: className } = Astro.props;

const Tag = `h${level}` as const;
const defaultSize: Record<Level, Size> = { 1: "h1", 2: "h2", 3: "h3" };

// Archivo's wdth axis condenses the larger sizes (DESIGN.md §3).
const sizes: Record<Size, string> = {
  display: "text-display font-stretch-75%",
  h1: "text-h1 font-stretch-80%",
  h2: "text-h2 font-stretch-85%",
  h3: "text-h3",
};
---

<Tag
  id={id}
  class:list={[
    "font-heading text-ink",
    sizes[size ?? defaultSize[level]],
    className,
  ]}
>
  <slot />
</Tag>
