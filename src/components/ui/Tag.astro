---
interface Props {
  /** `outline` for technologies, `plain` for inline metadata such as status. */
  variant?: "outline" | "plain";
  class?: string;
}

const { variant = "outline", class: className } = Astro.props;

const variants = {
  outline: "rounded-sm border border-line px-2 py-0.5",
  plain: "",
} as const;
---

<span
  class:list={[
    "inline-flex items-center text-sm text-ink-muted",
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
