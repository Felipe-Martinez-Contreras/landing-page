---
import type { SimpleIcon } from "simple-icons";

interface Props {
  icon: SimpleIcon;
  class?: string;
}

const { icon, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class:list={["size-5 shrink-0", className]}
>
  <path d={icon.path} />
</svg>
