---
interface Props {
  label: string;
  /** Id of the main landmark. */
  target?: string;
}

const { label, target = "contenido" } = Astro.props;
---

<a
  href={`#${target}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-3 focus:font-bold focus:text-accent-ink"
>
  {label}
</a>
